[Unit]
Description=Freqtrade Diagnostic Strategy (Monitoring/Testing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bederf
Group=bederf
WorkingDirectory=/home/bederf/freqtrade
Environment="PATH=/home/bederf/freqtrade/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/bederf/freqtrade/.env

# Main command with Diagnostic strategy
ExecStart=/home/bederf/freqtrade/.venv/bin/freqtrade trade \
    --config /home/bederf/freqtrade/config.json \
    --strategy DiagnosticStrategy \
    --db-url sqlite:////home/bederf/freqtrade/user_data/tradesv3_diagnostic.sqlite \
    --logfile /home/bederf/freqtrade/logs/freqtrade_diagnostic.log

# Restart policy
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitInterval=500

# Resource limits
MemoryLimit=1G
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
