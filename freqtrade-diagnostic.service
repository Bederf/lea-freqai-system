[Unit]
Description=Freqtrade Diagnostic Strategy (Monitoring/Testing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bederf
Group=bederf
WorkingDirectory=/home/bederf/lea-freqai-system
Environment="PATH=/home/bederf/lea-freqai-system/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=/home/bederf/lea-freqai-system/.env

# Main command with Diagnostic strategy
ExecStart=/home/bederf/lea-freqai-system/.venv/bin/python /home/bederf/lea-freqai-system/run_freqtrade_patched.py trade \
    --config /home/bederf/lea-freqai-system/user_data/config_diagnostic.json \
    --strategy DiagnosticStrategy \
    --freqaimodel PyTorchMLPRegressor \
    --db-url sqlite:////home/bederf/lea-freqai-system/user_data/tradesv3_diagnostic.sqlite \
    --logfile /home/bederf/lea-freqai-system/logs/freqtrade_diagnostic.log

# Restart policy
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitInterval=500
KillSignal=SIGINT
TimeoutStopSec=180
SuccessExitStatus=130 143
RestartPreventExitStatus=130 143

# Resource limits
MemoryLimit=1G
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
